<UserControl x:Class="wpfnavigation.views.SecondView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wpfnavigation.views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="0,63,0,0" TextWrapping="Wrap" Text="secondview"
                   VerticalAlignment="Top" />
        <Button Command="{Binding NavigateToHomeViewCommand2 }" Content="gohome" HorizontalAlignment="Left"
                Margin="140,170,0,0" VerticalAlignment="Top" />

    </Grid>
</UserControl>