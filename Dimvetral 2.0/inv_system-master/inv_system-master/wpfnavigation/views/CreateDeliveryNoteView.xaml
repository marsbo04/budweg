<UserControl x:Class="wpfnavigation.views.CreateDeliveryNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:wpfnavigation.views"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" Text="firstview"
                   VerticalAlignment="Top" />

        <Button Command="{Binding NavigateToHomeViewCommand}" Content="gohome" HorizontalAlignment="Left"
                Margin="60,238,0,0" VerticalAlignment="Top" />
        <TextBox TextWrapping="Wrap" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="119,74,137,198" />
        <Button Command="{Binding CreateDeliveryNoteCommand}" Content="Create note" HorizontalAlignment="Left"
                Margin="199,238,0,0" VerticalAlignment="Top" />

    </Grid>
</UserControl>