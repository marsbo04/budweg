<Window x:Class="dimvetral.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dimvetral"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#F5F5F5">
        <!-- Hovedramme der tilpasser sig skærmen -->
        <Border BorderBrush="Black" BorderThickness="3" Margin="15" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Venstre side tager 65% af pladsen, højre tager 35% -->
                    <ColumnDefinition Width="6.5*" />
                    <ColumnDefinition Width="3.5*" />
                </Grid.ColumnDefinitions>

                <!-- VENSTRE SEKTION: Historik (Responsiv container) -->
                <Border BorderBrush="Black" BorderThickness="0,0,2,0">
                    <Grid Margin="20">
                        <TextBlock Text="Kaliber følgeseddel / Historik" 
                               FontWeight="Bold" 
                               FontSize="20" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Top" />

                        <!-- Her kan din DataGrid eller liste over historik placeres -->
                    </Grid>
                </Border>

                <!-- HØJRE SEKTION: Kontrolpanel -->
                <Grid Grid.Column="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Bruger info -->
                        <RowDefinition Height="*" />
                        <!-- Center ikon -->
                        <RowDefinition Height="Auto" />
                        <!-- Knapper i bunden -->
                    </Grid.RowDefinitions>

                    <!-- Top: ID Information -->
                    <StackPanel Grid.Row="0">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Medarbejder ( ID )" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Ellipse Width="35" Height="35" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Bremseskaliber ( ID )" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Ellipse Width="35" Height="35" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Midte: Stort Responsivt Ikon -->
                    <Viewbox Grid.Row="1" MaxHeight="200" Margin="0,20">
                        <Grid Width="100" Height="100">
                            <Ellipse Stroke="Black" StrokeThickness="2" Fill="Transparent" />
                            <Path Data="M 30,35 L 50,25 L 70,35 L 70,60 L 50,70 L 30,60 Z M 30,35 L 50,45 L 70,35 M 50,45 L 50,70" 
                                  Stroke="Black" StrokeThickness="2" />
                        </Grid>
                    </Viewbox>

                    <!-- Bund: Aktioner -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <!-- Knappen til at tilføje ny kaliber -->
                        <Button Content="Tilføj ny kaliber" 
                                Padding="10"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="2"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand"
                                Margin="0,0,0,15" />

                        <!-- Log ud knap -->
                        <Button Content="Log ud" 
                                Foreground="Red"
                                FontWeight="Bold"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                Padding="10"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
