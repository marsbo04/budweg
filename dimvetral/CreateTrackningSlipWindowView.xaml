<Window x:Class="dimvetral.CreateTrackningSlipWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dimvetral"
        mc:Ignorable="d"
        Title="CreateTrackningSlipWindowView" Height="450" Width="800">
    <Window.Resources>
        <!-- Circular Button Style -->
        <Style x:Key="CircularButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="10" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="#B0B0B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Background="#F5F5F5">
            <!-- Hovedramme der tilpasser sig skærmen -->
            <Border BorderBrush="Black" BorderThickness="3" Margin="15" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Venstre side tager 65% af pladsen, højre tager 35% -->
                        <ColumnDefinition Width="6.5*" />
                    </Grid.ColumnDefinitions>

                    <!-- VENSTRE SEKTION:-->
                    <Border BorderBrush="Black" BorderThickness="0,0,2,0" Grid.ColumnSpan="2">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Cirkulære knapper i toppen -->
                            <UniformGrid Grid.Row="0" 
                                         Rows="1" 
                                         Columns="3"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Top"
                                         Margin="0,20,0,0" Width="592">
                                <!-- Start knap -->
                                <Button x:Name="KaliberDel1" 
                                        Click="KaliberDel1"
                                        Style="{StaticResource CircularButton}"
                                        Width="100"
                                        Height="100"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="2"
                                        Tag="#E0E0E0"
                                        Cursor="Hand"
                                        Margin="10">
                                    <TextBlock Text="KaliberDel1" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               TextAlignment="Center" />
                                </Button>

                                <!-- Help knap -->
                                <Button x:Name="KaliberDel2" 
                                        Click="KaliberDel2"
                                        Style="{StaticResource CircularButton}"
                                        Width="100"
                                        Height="100"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="2"
                                        Tag="#E0E0E0"
                                        Cursor="Hand"
                                        Margin="10">
                                    <TextBlock Text="KaliberDel2" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               TextAlignment="Center" />
                                </Button>

                                <!-- Exit knap -->
                                <Button x:Name="KalibrDel3" 
                                        Click="KaliberDel3"
                                        Style="{StaticResource CircularButton}"
                                        Width="100"
                                        Height="100"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="2"
                                        Tag="#FFE0E0"
                                        Cursor="Hand"
                                        Margin="10">
                                    <TextBlock Text="KaliberDel3" 
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextAlignment="Center" />
                                </Button>
                            </UniformGrid>

                            <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,1">
                                <TextBlock Text="Bemærknig" Margin="0,0,0,1" FontWeight="SemiBold"/>
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap" 
                                         MaxHeight="200" Width="503"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" Height="200"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,0">
                                <Button Command="{Binding CreateDeliveryNoteCommand}" Content="Gem" Width="100" Height="30" Margin="0,10,0,0" Click="SaveButton_Click"/>
                                <Button Command="{Binding NavigateToHomeViewCommand}" Content="Annuller" Width="100" Height="30" Margin="0,10,0,0" Click="CancelButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>





        </Grid>
    </Grid>
</Window>
