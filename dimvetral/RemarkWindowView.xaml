<Window x:Class="dimvetral.CreateTrackningSlipWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dimvetral"
        mc:Ignorable="d"
        Title="CreateTrackningSlipWindowView" Height="450" Width="800">

    <Grid>
        <!-- VENSTRE SEKTION:-->
        <Border BorderBrush="Black" BorderThickness="0,0,2,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" 
                             Rows="1" 
                             Columns="3"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,20,0,0">                   
                </UniformGrid>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,1">
                    <TextBlock Text="Bemærknig" Margin="0,0,0,1" FontWeight="SemiBold"/>
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" 
                             MaxHeight="200" Width="578"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Height="337"/>
                    <Button Content="Gem" Width="100" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
