@startuml UC1DCD
title Design Class Diagram - UC1: Opret Følgeseddel

hide circle

package "View" {
    class CreateTrackingSlipView {
        -viewModel: CreateTrackingSlipViewModel
    }
}

package "ViewModel" {
    class CreateTrackingSlipViewModel {
        +SelectedStationID: int
        +InputStartInfo: String
        +ErrorMessage: String
        +CreateTrackingSlipCommand(): void
        -ValidateInput(): boolean
    }
    
    class LabelPrinter {
        +print(trackingSlip: CaliberTrackingSlip): void
    }
}

package "Model" {
    class TrackingSlipService {
        +createTrackingSlip(stationID: int, info: String): CaliberTrackingSlip
        -generateUniqueID(): String
    }

    class CaliberTrackingSlip {
        +ID: String
        +StartDate: DateTime
        +History: List<String>
        +Warehouse: String
        +Location: String
        +Status: String
    }

    class Station {
        +StationID: int
        +StationName: String
        -StartDate : DateTime
        -EndDate : DateTime
        -Status: String
        -Remark: String
        -BuildingName: String
    }
    
    class Building {
        +BuildingName: String
        +Section: String
    }

    class Employee {
        +ID: int
        +Name: String
        +StationID: int
    }

    class EmployeeRepository {
        +Add(employee: Employee)
        +GetAll(): List<Employee>
        +GetByID(id: int): Employee
        +FindByName(name: String): List<Employee>
    }

    class StationRepository {
        +Add(station: Station)
        +GetAll(): List<Station>
        +GetByID(id: int): Station
    }
    
    class TrackingSlipRepository {
        +Add(trackingSlip: CaliberTrackingSlip)
        +GetByID(id: String): CaliberTrackingSlip
        +GetAll(): List<CaliberTrackingSlip>
        +GetHistory(caliberID: String): List<CaliberTrackingSlip>
    }
}

CreateTrackingSlipView ..> CreateTrackingSlip : Data Binding
CreateTrackingSlip --> TrackingSlipService : Uses
TrackingSlipService --> CaliberTrackingSlip : Instantiates
TrackingSlipService --> Station : Associates
CreateTrackingSlip --> LabelPrinter : Uses

' Model layer only associations
Building "1..*" -- "1" Station : Contains
Employee "1..*" -- "1" Station : Works at
CaliberTrackingSlip "1..*" -- "1..*" Station : Keeps history of

@enduml
