@startuml
title Sequence Diagram – Opret Følgeseddel 


participant ":Følgeseddel" as F
participant ":Station" as ST
participant ":Medarbejder" as ME


[o-> F: opretFølgeseddel(deltype,\n startDato,\n startStatus,\n bemærkning,\n medarbejderID)
activate F


F -> ME: findMedarbejder(medarbejderID)
activate ME
ME --> F: medarbejder(navn, stationID )
deactivate ME
F -> ST: findStation(stationID)
activate ST
ST --> F: station(navn)      
deactivate ST


F -> F: create(deltype, startDato,\n startStatus, bemærkning,\n station, medarbejder)


F --> F: kaliberID


F -> F: historikListe.add("oprettet",\n medarbejder, timestamp,\n station, kaliberID, Bemærkning)


<-- F: sporingsID + labelData
deactivate F

@enduml